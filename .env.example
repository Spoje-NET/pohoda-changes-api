APP_NAME=PohodaChangesApi
EASE_LOGGER=console|syslog
APP_DEBUG=false

# Own service database (not Pohoda MSSQL)
DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/pohoda-changes-api/pohoda-changes.db
# DB_CONNECTION=pgsql
# DB_HOST=localhost
# DB_PORT=5432
# DB_DATABASE=pohoda_changes
# DB_USERNAME=pohoda_changes
# DB_PASSWORD=

# Optional shared mServer defaults (per-unit url/ico/year live in accounting_units)
POHODA_USERNAME=
POHODA_PASSWORD=

# Poll mode: mserver (default, all Pohoda editions) | mssql (optional when SQL is available)
# Most editions have no MSSQL — keep mserver. mssql only discovers IDs via DatSave;
# document bodies are still always loaded from mServer.
POLL_MODE=mserver
# POHODA_MSSQL_HOST=10.11.25.23
# POHODA_MSSQL_PORT=1433
# POHODA_MSSQL_USER=
# POHODA_MSSQL_PASSWORD=
# POHODA_MSSQL_SETTINGS=TrustServerCertificate=yes
# First MSSQL poll only stores MAX(DatSave) watermark (skip full historical export)
# POLL_MSSQL_SEED_ONLY=true
# Optional safety cap per agenda per cycle
# POLL_MSSQL_LIMIT=500

POHODA_AGENDAS=invoice,bank,addressBook
POLL_INTERVAL=120
RECORD_CACHE_MIN_VERSIONS=2
CACHE_API_TOKEN=
CACHE_PUBLIC_BASE=http://localhost/pohoda-changes-api
