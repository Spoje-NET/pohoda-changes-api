#!/usr/bin/env php
<?php

declare(strict_types=1);

\define('APP_NAME', 'PohodaChangesWebhookDisable');

require_once __DIR__.'/../vendor/autoload.php';

\Ease\Shared::init(
    ['DB_CONNECTION', 'DB_HOST', 'DB_PORT', 'DB_DATABASE', 'DB_USERNAME', 'DB_PASSWORD'],
    __DIR__.'/../.env',
);

$opts = getopt('', ['id:', 'enable', 'help']);

if (isset($opts['help']) || empty($opts['id'])) {
    fwrite(STDERR, "Usage: webhook-disable --id=N [--enable]\n");
    exit(1);
}

$ep = new \Pohoda\Changes\Webhook\Endpoint();
$ep->setEnabled((int) $opts['id'], isset($opts['enable']));
echo (isset($opts['enable']) ? 'Enabled' : 'Disabled').' webhook id='.$opts['id']."\n";
