#!/usr/bin/env php
<?php

declare(strict_types=1);

\define('APP_NAME', 'PohodaChangesUnitList');

require_once __DIR__.'/../vendor/autoload.php';

\Ease\Shared::init(
    ['DB_CONNECTION', 'DB_HOST', 'DB_PORT', 'DB_DATABASE', 'DB_USERNAME', 'DB_PASSWORD'],
    __DIR__.'/../.env',
);

$units = new \Pohoda\Changes\AccountingUnit();

printf("%-5s %-12s %-6s %-6s %-40s %s\n", 'ID', 'ICO', 'YEAR', 'EN', 'URL', 'DB');

foreach ($units->listAll() as $u) {
    printf(
        "%-5s %-12s %-6s %-6s %-40s %s\n",
        $u['id'],
        $u['ico'],
        $u['year'],
        ((int) $u['enabled']) ? 'yes' : 'no',
        $u['url'],
        $u['db_database'] ?? '',
    );
}
